<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_home_product_card"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="112dp"
        android:background="@drawable/bg_input">

        <ImageView
            android:id="@+id/ivCartProductImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCartProductEmoji"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="36sp"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCartProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:textColor="@color/espresso"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2" />

        <TextView
            android:id="@+id/tvCartProductDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/manrope"
            android:textColor="@color/cocoa"
            android:textSize="11sp"
            android:maxLines="2" />

        <TextView
            android:id="@+id/tvCartProductPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/manrope"
            android:textColor="@color/espresso"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCartDecrease"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_secondary_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/espresso"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvCartQuantity"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:fontFamily="@font/manrope"
                android:textColor="@color/espresso"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCartIncrease"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_secondary_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/espresso"
                android:textSize="20sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvCartRemove"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:fontFamily="@font/manrope"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:text="@string/cart_remove"
                android:textColor="@color/cocoa"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>