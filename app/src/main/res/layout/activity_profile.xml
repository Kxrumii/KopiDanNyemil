<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oat_milk"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".ProfileActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/profileContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="16dp">

                <ImageButton
                    android:id="@+id/btnProfileBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_back_button"
                    android:src="@drawable/ic_arrow_back"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/back_description"
                    app:tint="@color/espresso" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/latte"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_meta_index"
                    android:fontFamily="@font/ibm_plex_mono_regular"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:textColor="@color/cocoa" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/profileIdentity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="30dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginEnd="112dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_meta_subtitle"
                        android:fontFamily="@font/ibm_plex_mono_regular"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:textColor="@color/caramel" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/profile_headline"
                        android:fontFamily="@font/instrument_serif"
                        android:textSize="32sp"
                        android:textStyle="italic"
                        android:textColor="@color/espresso"
                        android:maxLines="2"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/manrope"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/espresso"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="Nadia Putri" />

                    <TextView
                        android:id="@+id/tvProfileUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/ibm_plex_mono_regular"
                        android:textSize="10sp"
                        android:textColor="@color/cocoa" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="112dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/bg_profile_avatar">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        android:contentDescription="@string/profile_avatar_description"
                        app:tint="@color/espresso" />

                </FrameLayout>

            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="30dp"
                android:background="@color/latte" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_personal_details"
                    android:fontFamily="@font/ibm_plex_mono_regular"
                    android:textSize="10sp"
                    android:letterSpacing="0.12"
                    android:textColor="@color/caramel" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/profile_full_name_label"
                    android:fontFamily="@font/manrope"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/espresso" />

                <EditText
                    android:id="@+id/etProfileFullName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:fontFamily="@font/manrope"
                    android:textSize="14sp"
                    android:textColor="@color/espresso"
                    android:hint="@string/profile_full_name_hint"
                    android:inputType="textCapWords|textPersonName"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:selectAllOnFocus="false"
                    tools:text="Fahri Khairun Ariansyah" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/profile_username_label"
                    android:fontFamily="@font/manrope"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/espresso" />

                <TextView
                    android:id="@+id/tvProfileUsernameValue"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:fontFamily="@font/manrope"
                    android:textSize="14sp"
                    android:textColor="@color/cocoa"
                    android:clickable="false"
                    android:focusable="false"
                    tools:text="Fahrii" />

                <Button
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_button_primary_pill"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:fontFamily="@font/manrope"
                    android:text="@string/profile_save_changes"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/oat_milk"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <Button
                    android:id="@+id/btnProfileLogout"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_secondary_pill"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:fontFamily="@font/manrope"
                    android:text="@string/profile_logout"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/espresso"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
